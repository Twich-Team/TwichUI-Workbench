{
  "name": "twichui-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "contracts": "PYTHONPATH=backend .venv/bin/python scripts/export_openapi.py && openapi-typescript frontend/openapi.json -o frontend/src/api.generated.ts",
    "check": "npm run contracts && tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts && .venv/bin/ruff check backend migrations scripts && PYTHONPATH=backend .venv/bin/python scripts/check_db.py",
    "test": ".venv/bin/python -m pytest && vitest run --config frontend/vite.config.ts",
    "test-e2e": "playwright test --project=chromium",
    "test-visual": "playwright test --project=visual",
    "verify": "npm run check && npm test && npm run test-e2e && npm run test-visual"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
